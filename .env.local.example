# Copy to .env.local and fill in real values (do NOT commit .env.local)
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/socialsea
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=change_me

# OpenAI (optional; used by Study Assistant / voice features)
OPENAI_API_KEY=
APP_OPENAI_VOICE_MALE=alloy
APP_OPENAI_VOICE_FEMALE=nova

# Google Gemini (optional; used by Study Assistant text/voice fallback)
GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-2.0-flash

# LiveKit (required for video calls)
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
