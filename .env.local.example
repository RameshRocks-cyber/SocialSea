# Copy to .env.local and fill in real values (do NOT commit .env.local)
# Default local profile uses H2 for zero-setup startup. Use `dev` to force PostgreSQL.
SPRING_PROFILES_ACTIVE=dev,h2
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/socialsea
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
JWT_SECRET=change_me

# Redis (used for shared cache, rate limiting, and other scale-out features)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_TIMEOUT=2s
APP_REDIS_CACHE_TTL=10m

# Redis presence
APP_PRESENCE_ONLINE_TTL=5m
APP_PRESENCE_SESSION_TTL=12h
APP_PRESENCE_LAST_SEEN_TTL=7d
APP_PRESENCE_PERSIST_THROTTLE=15s

# OpenAI (optional; used by Study Assistant / voice features)
OPENAI_API_KEY=
APP_OPENAI_VOICE_MALE=alloy
APP_OPENAI_VOICE_FEMALE=nova

# Google Gemini (optional; used by Study Assistant text/voice fallback)
GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-2.0-flash

# LiveKit (required for video calls)
LIVEKIT_URL=wss://your-livekit-host.livekit.cloud
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

# Cloudinary (required for cloud media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload provider (optional): cloudinary (default) or s3
# APP_UPLOAD_PROVIDER=s3
# APP_S3_BUCKET=your-bucket
# APP_S3_PREFIX=socialsea
# APP_S3_REGION=ap-south-1

# Upload limits (optional)
# SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=1GB
# SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=1GB
# APP_UPLOAD_MAX_BYTES=1073741824

# Video editing (optional; ffmpeg/ffprobe required when enabled)
# APP_VIDEO_EDITING_ENABLED=true
# APP_VIDEO_EDITING_FFMPEG_BIN=ffmpeg
# APP_VIDEO_EDITING_FFPROBE_BIN=ffprobe
# APP_VIDEO_EDITING_TIMEOUT_SECONDS=240
# APP_VIDEO_EDITING_DRAWTEXT_FONT_FILE=

# Web push notifications (optional, but required for device notification shade alerts)
# Generate VAPID keys and set both values:
# APP_WEB_PUSH_PUBLIC_KEY=
# APP_WEB_PUSH_PRIVATE_KEY=
# APP_WEB_PUSH_SUBJECT=mailto:support@socialsea.co.in
